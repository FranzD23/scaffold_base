          <div class="fact-card">
            <div class="fact-val" id="modalTime"></div>
            <div class="fact-lbl">Tiempo Estimado</div>
          </div>
          <div class="fact-card">
            <div class="fact-val" id="modalCalories"></div>
            <div class="fact-lbl">Calorías</div>
          </div>
          <div class="fact-card">
            <div class="fact-val" id="modalProtein"></div>
            <div class="fact-lbl">Proteínas</div>
          </div>
        </div>

