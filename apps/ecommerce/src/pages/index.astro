        <div class="modal-badges">
          <span id="modalSpecialty" class="badge-specialty legend"></span>
          <span id="modalBadge" class="badge-tag"></span>
        </div>

        <h3 id="modalTitle" class="modal-title"></h3>
        <div id="modalPrice" class="modal-price-tag"></div>

        <p id="modalDesc" style="color: var(--text-body); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem;"></p>

        <div class="modal-info-section">
          <div class="modal-section-title">Ingredientes y Preparación Artesanal:</div>
          <div id="modalIngredients" class="modal-ingredients"></div>
        </div>

