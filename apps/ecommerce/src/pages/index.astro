  <!-- Client-side Interactive Script -->
  <script>
    // Tab Filters
    const tabBtns = document.querySelectorAll('.tab-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        tabBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');
        burgerCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Modal Details logic
    const modal = document.getElementById('burgerModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const detailButtons = document.querySelectorAll('.btn-details');

    const modalImg = document.getElementById('modalImg') as HTMLImageElement;
    const modalTitle = document.getElementById('modalTitle');
    const modalSpecialty = document.getElementById('modalSpecialty');
    const modalBadge = document.getElementById('modalBadge');
    const modalPrice = document.getElementById('modalPrice');
    const modalDesc = document.getElementById('modalDesc');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalTime = document.getElementById('modalTime');
    const modalCalories = document.getElementById('modalCalories');
    const modalProtein = document.getElementById('modalProtein');
    const modalPairing = document.getElementById('modalPairing');

    detailButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const raw = btn.getAttribute('data-burger');
        if (!raw) return;
        const burger = JSON.parse(raw);

        if (modalImg) modalImg.src = burger.image;
        if (modalImg) modalImg.alt = burger.name;
        if (modalTitle) modalTitle.textContent = burger.name;
        if (modalSpecialty) {
          modalSpecialty.textContent = burger.specialtyLevel;
          modalSpecialty.className = `badge-specialty ${burger.specialtyType || 'legend'}`;
        }
        if (modalBadge) modalBadge.textContent = burger.badge;
        if (modalPrice) modalPrice.textContent = `$${burger.price.toFixed(2)}`;
        if (modalDesc) modalDesc.textContent = burger.description;
        if (modalIngredients) modalIngredients.textContent = burger.ingredients;
        if (modalTime) modalTime.textContent = burger.prepTime;
        if (modalCalories) modalCalories.textContent = burger.calories;
        if (modalProtein) modalProtein.textContent = burger.protein;
        if (modalPairing) modalPairing.textContent = burger.pairing;

        if (modal) modal.classList.add('active');
        document.body.style.overflow = 'hidden';
      });
    });

    const closeModal = () => {
      if (modal) modal.classList.remove('active');
      document.body.style.overflow = '';
    };

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeModal();
    });
  </script>
</body>
